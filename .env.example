# ==============================================================================
# VARIABLES DE ENTORNO - NOTIFICACIONES TRACKBELL SR (servidor B / Servidor-107)
# ==============================================================================
# Copia este archivo como '.env' en el servidor B y reemplaza cada <...> por el
# valor real. Este archivo SOLO lleva placeholders: nunca pongas aquí tokens,
# claves ni contraseñas. El '.env' real no se sube al repositorio.
# ==============================================================================

# ── Entorno de ASP.NET Core ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
# Swagger UI en /notificaciones-trackbell/swagger/index.html (true para activarlo en B)
EnableSwagger=false

# ── Base de datos MySQL (GTS de B) ───────────────────────────────────────────
# mysql-gts es el contenedor MySQL 8.0 de B, alcanzable por la red Docker app-net.
# Reemplaza <GTSUSER_PASSWORD> por la contraseña de gtsuser.
ConnectionStrings__GtsDatabase=Server=mysql-gts;Port=3306;Database=gts;Uid=gtsuser;Password=<GTSUSER_PASSWORD>;Charset=utf8mb4;Pooling=true;Allow User Variables=True;MinimumPoolSize=5;MaximumPoolSize=200;ConnectionTimeout=60;ConnectionLifeTime=300;ConnectionReset=true;DefaultCommandTimeout=120;

# ── Token estático de la API ─────────────────────────────────────────────────
# Requerido en header 'Authorization: Bearer <token>' o 'X-API-KEY: <token>'.
# Genera uno propio y largo (p. ej. openssl rand -hex 32).
StaticApiToken=<STATIC_API_TOKEN>

# ── Clave secreta para validar tokens JWT (mínimo 32 caracteres) ─────────────
settings__secretkey=<JWT_SECRET_KEY>

# ── Intervalo de sondeo en segundos para eventos de geocerca ─────────────────
PollingIntervalSeconds=2

# ── Orígenes permitidos para CORS (separados por coma) ────────────────────────
# Ejemplo para B (más localhost:3000 para desarrollo):
#   AllowedOrigins=https://sr.velsat.pe:8443,http://localhost:3000
AllowedOrigins=<ALLOWED_ORIGINS>

# ── Servicio de Notificaciones por WhatsApp (whatsapp-api del servidor A) ────
WhatsApp__Enabled=true
WhatsApp__ApiUrl=https://do.velsat.pe:8443/whatsapp/api/send/single
# API key de la whatsapp-api de A (header x-api-key)
WhatsApp__ApiKey=<WHATSAPP_API_KEY>
WhatsApp__TimeoutMs=10000
WhatsApp__DelayBetweenSendsMs=400
